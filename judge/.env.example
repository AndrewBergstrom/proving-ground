# Copy to .env and fill in. Used by docker-compose for the Caddy edge.
#   cp .env.example .env

# The public hostname for the judge (point its DNS A record at this box).
JUDGE_DOMAIN=judge.example.com

# EXACT origin of your app - Caddy allows CORS only from here. No trailing slash.
APP_ORIGIN=https://proving-ground-theta.vercel.app

# Email for Let's Encrypt / ACME notifications.
ACME_EMAIL=you@example.com

# Must match AUTHN_TOKEN in judge0.conf. Caddy injects it; the browser never sees it.
JUDGE0_AUTH_TOKEN=CHANGE_ME_auth_token

# Per-IP rate limit: at most RATE_EVENTS requests per RATE_WINDOW.
RATE_EVENTS=40
RATE_WINDOW=60s
