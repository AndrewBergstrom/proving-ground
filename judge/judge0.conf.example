# Judge0 configuration. Copy to judge0.conf and fill in the CHANGE_ME values.
#   cp judge0.conf.example judge0.conf
# Generate each secret with:  openssl rand -hex 32
#
# IMPORTANT: config keys can shift between Judge0 versions. This targets
# 1.13.1. If something is ignored, diff against the judge0.conf shipped inside
# the judge0/judge0:1.13.1 image and reconcile.

################################################################################
# Auth - every API request must carry this token in the X-Auth-Token header.
# Caddy injects it for you; keep it secret and off the client.
################################################################################
AUTHN_HEADER=X-Auth-Token
AUTHN_TOKEN=CHANGE_ME_auth_token

# Admin token for privileged endpoints (config_info, workers, etc.).
AUTHZ_HEADER=X-Auth-User
AUTHZ_TOKEN=CHANGE_ME_admin_token

# Do not let API callers list or read arbitrary submissions in bulk.
ALLOW_ENUMERATE=false

################################################################################
# Postgres
################################################################################
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

################################################################################
# Redis
################################################################################
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

################################################################################
# Sandbox resource ceilings - the hard caps a submission may request.
# These bound worst-case abuse. Per-run limits are also sent by the app.
################################################################################
# CPU seconds per run (compile + execute is bounded separately by Judge0).
MAX_CPU_TIME_LIMIT=10
CPU_TIME_LIMIT=5
# Wall-clock seconds (guards infinite loops / sleeps).
MAX_WALL_TIME_LIMIT=20
WALL_TIME_LIMIT=10
# Memory in KB (256 MB).
MAX_MEMORY_LIMIT=256000
MEMORY_LIMIT=128000
# Max processes/threads a submission may spawn (guards fork bombs).
MAX_PROCESSES_AND_OR_THREADS=60
MAX_MAX_PROCESSES_AND_OR_THREADS=120
# Output cap in KB.
MAX_STACK_LIMIT=64000
# Cap the amount a submission can write to stdout/stderr/file.
MAX_FILE_SIZE=10240
MAX_MAX_FILE_SIZE=20480

################################################################################
# Networking - keep the sandbox OFFLINE. Untrusted code must not reach out.
################################################################################
ENABLE_NETWORK=false
ALLOW_ENABLE_NETWORK=false

################################################################################
# Misc hardening
################################################################################
# Don't let callers delete submissions.
ENABLE_SUBMISSION_DELETE=false
# Keep wait=true available for simple synchronous runs from the app.
ENABLE_WAIT_RESULT=true
# Batch size cap.
MAX_SUBMISSION_BATCH_SIZE=20
# How long finished submissions are kept before cleanup (seconds).
SUBMISSION_CACHE_DURATION=3600
MAINTENANCE_MODE=false
